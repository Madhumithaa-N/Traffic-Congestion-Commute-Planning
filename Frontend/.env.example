# Frontend environment variables for Vite
# Copy this file to .env.local and fill in actual values.
# .env.local is gitignored — never commit keys.

# ── Backend API URL ───────────────────────────────────────────────────────────
# URL of the running FastAPI backend (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000

# ── Google Maps JavaScript API Key ───────────────────────────────────────────
# This key is embedded in the browser bundle. Restrict it to HTTP referrers.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here