# ─────────────────────────────────────────────────────────────────
# Frontend Environment Variables — copy this file to .env
# and fill in your values. Then add each key to Render's
# "Environment" dashboard (do NOT add PORT — Render injects it).
# ─────────────────────────────────────────────────────────────────

# Google Maps JavaScript API key (required for the live traffic map)
# Obtain from: https://console.cloud.google.com/google/maps-apis/
# Must be prefixed VITE_ so Vite exposes it to the browser bundle.
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Gemini AI API key (required for AI-powered route suggestions)
# Obtain from: https://aistudio.google.com/app/apikey
# Must be prefixed VITE_ so Vite exposes it to the browser bundle.
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Backend API base URL (required if the frontend calls the Python backend)
# Set this to your Render Web Service URL, e.g. https://smartroute-api.onrender.com
# Must be prefixed VITE_ so Vite exposes it to the browser bundle.
VITE_API_URL=https://your-backend-service.onrender.com
