# ─────────────────────────────────────────────────────────────────
# SmartRoute AI – Backend Environment Variables
# Copy this file to .env and fill in your values.
# Add each key to Render's "Environment" dashboard.
# Do NOT add PORT — Render injects it automatically.
# ─────────────────────────────────────────────────────────────────

# URL of the deployed frontend (your Render Static Site URL).
# Used by Flask-CORS to restrict cross-origin requests to this origin only.
# Example: https://smartroute.onrender.com
FRONTEND_URL=https://your-frontend-site.onrender.com

# Absolute path to the trained .joblib model file.
# Default: <backend_dir>/ml_model/traffic_prediction_model.joblib
# Only set this if the model is stored in a non-default location.
# MODEL_PATH=/opt/render/project/src/backend/ml_model/traffic_prediction_model.joblib

# Absolute path to the CSV dataset (used only when retraining on deploy).
# Default: <backend_dir>/ml_model/road_traffic_4354_records.csv
# CSV_PATH=/opt/render/project/src/backend/ml_model/road_traffic_4354_records.csv
