# SmartRoute AI – Backend .env
# Copy this file to .env and fill in your actual API keys.
# .env is listed in .gitignore and will NEVER be committed.

# ── Google Maps Platform ──────────────────────────────────────────────────────
# Required for: Google Routes API v2, Directions API, Maps JavaScript API
# Restrictions: HTTP referrers for frontend key; IP/server restriction for backend key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Required for: AI-powered commute explanations
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Gemini Model (optional, defaults to gemini-2.0-flash) ─────────────────────
# GEMINI_MODEL=gemini-2.0-flash

# ── ML Model paths (optional, auto-resolved relative to backend/ml_model/) ────
# ML_MODEL_PATH=/absolute/path/to/traffic_prediction_model.joblib
# ML_CSV_PATH=/absolute/path/to/road_traffic_4354_records.csv

# ── Server settings (optional) ────────────────────────────────────────────────
# BACKEND_HOST=0.0.0.0
# BACKEND_PORT=8000

# ── CORS origins (optional, comma-separated) ──────────────────────────────────
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Request timeout seconds (optional) ───────────────────────────────────────
# REQUEST_TIMEOUT=20

# ── Traffic cache TTL seconds (optional) ─────────────────────────────────────
# TRAFFIC_CACHE_TTL=60
