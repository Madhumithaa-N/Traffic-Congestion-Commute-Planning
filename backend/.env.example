# SmartRoute AI – Backend Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env and fill in actual values.
# .env is gitignored – never commit secrets.
#
# On Render: set these in Dashboard → Service → Environment.

# ── Required: Google APIs ─────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional: Gemini model (default: gemini-2.0-flash) ───────────────────────
GEMINI_MODEL=gemini-2.0-flash

# ── Optional: CORS origins (comma-separated, no trailing slash) ───────────────
# For production on Render, replace with your actual frontend URL:
#   CORS_ORIGINS=https://smartroute-frontend.onrender.com,http://localhost:3000
# For development, use * to allow all:
#   CORS_ORIGINS=*
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# ── Optional: Server settings ─────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
REQUEST_TIMEOUT=20

# ── Optional: Cache TTL for traffic API responses (seconds) ──────────────────
TRAFFIC_CACHE_TTL=60
